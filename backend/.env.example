APP_ENV=development
CORS_ORIGINS=http://localhost:5173
SQLITE_DB_PATH=data/ai_chat.db

LONGCAT_BASE_URL=https://api.z.ai/api/paas/v4/
LONGCAT_MODEL=glm-5.3-flash
LONGCAT_CONTEXT_WINDOW_TOKENS=1048576
LONGCAT_API_KEY=replace-with-your-zai-api-key

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_knowledge

PARENT_CHUNK_SIZE=1600
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=80
DENSE_RETRIEVAL_TOP_K=20
SPARSE_RETRIEVAL_TOP_K=20
RETRIEVAL_CHILD_TOP_K=30
RERANK_CANDIDATE_TOP_K=12
RERANK_PARENT_TOP_K=4
RERANK_MIN_SCORE=0.4
RERANK_MODEL=BAAI/bge-reranker-v2-m3

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace-with-your-local-api-key

AGENTIC_MAX_PLAN_TASKS=4
AGENTIC_MAX_SCOPE_TASKS=3
AGENTIC_TASK_MAX_RETRIEVALS=2
AGENTIC_MAX_CONCURRENCY=3
